# EventFlow environment variables
# Copy this file to `.env` and fill in the values for your Supabase project.
# Find them in the Supabase dashboard under Project Settings → API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key (sb_publishable_...) — legacy anon JWTs are rejected for Storage uploads.
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional — used for metadata/branding defaults
VITE_APP_NAME=EventFlow
VITE_APP_URL=http://localhost:5173

# Optional — real email delivery for campaigns and broadcasts.
# Leave VITE_EMAIL_PROVIDER empty (or "mock") to simulate sending.
# Allowed providers: resend | sendgrid
# VITE_EMAIL_PROVIDER=resend
# VITE_EMAIL_API_KEY=your-provider-api-key
# VITE_EMAIL_FROM=EventFlow <no-reply@your-domain.com>

# Optional — account deletion recovery window in days (default 30).
# Set to 0 to disable self-service restoration entirely.
# VITE_ACCOUNT_DELETION_GRACE_DAYS=30
