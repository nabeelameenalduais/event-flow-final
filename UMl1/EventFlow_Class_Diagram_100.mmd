    ServiceModules.ChatService ..> CoreEntities.ChatMessage : uses
    ServiceModules.EvaluationService ..> CoreEntities.Evaluation : uses
    ServiceModules.NotificationService ..> CoreEntities.Notification : uses
    ServiceModules.EmailService ..> CoreEntities.EmailTemplate : uses
    ServiceModules.UserService ..> CoreEntities.Profile : uses
    ServiceModules.MeetingService ..> SupportEntities.MeetingPresence : uses
    ServiceModules.ReportService ..> CoreEntities.EventCost : uses
    ServiceModules.SettingsService ..> CoreEntities.AppSettings : uses
