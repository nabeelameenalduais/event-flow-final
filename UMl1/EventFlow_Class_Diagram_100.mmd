        }
        class Currency {
            <<support>>
            +code: string
            +name: string
            +ratePerUsd: number
            +ratePerYer: number
            +isActive: boolean
        }
        class UserBan {
            <<support>>
            +id: string
            +userId: string
            +scope: BanScope
            +status: BanStatus
            +isPermanent: boolean
            +approvedBy: string
        }
        class BanRevokeRequest {
            <<support>>
            +id: string
            +banId: string
            +status: string
            +requestedBy: string
        }
        class EventRequest {
            <<support>>
            +id: string
            +requesterId: string
            +title: string
            +eventType: EventType
            +status: EventRequestStatus
            +createdEventId: string
        }
        class AdminMessage {
            <<support>>
            +id: string
            +title: string
            +channel: AdminMessageChannel
            +targetType: AdminMessageTarget
            +status: CampaignStatus
            +createdBy: string
        }
        class AdminMessageRecipient {
            <<support>>
            +id: string
            +messageId: string
            +userId: string
            +email: string
            +emailStatus: string
        }
        class PasswordOtpCode {
            <<support>>
            +id: string
            +userId: string
            +codeHash: string
            +expiresAt: string
            +attempts: number
            +consumedAt: string
        }
        class PasswordResetRequestItem {
            <<support>>
            +id: string
            +userId: string
            +email: string
            +status: string
            +handledBy: string
        }
    }

    namespace AppViews {
        class ChatMessageWithSender {
            <<view>>
            +senderName: string
            +senderRole: string
        }
        class AudienceAccess {
            <<view>>
            +canView: boolean
            +canEdit: boolean
            +canSend: boolean
            +isAdmin: boolean
        }
        class FinanceSummary {
            <<view>>
            +totalFundingUsd: number
            +balanceUsd: number
            +byCurrency: array
        }
        class Attachment {
            <<value>>
            +name: string
            +url: string
            +size: number
        }
    }

    namespace ServiceModules {
        class AuthService {
            <<service>>
            +login()
            +register()
            +restoreSession()
            +revokeSession()
            +requestPasswordReset()
            +resetPasswordWithToken()
        }
        class EventService {
            <<service>>
            +createEvent()
            +updateEvent()
            +publishEvent()
            +archiveEvent()
            +setDraft()
            +registerForEvent()
            +cancelRegistration()
            +deleteRegistrationHard()
        }
        class TicketService {
            <<service>>
            +generateTicket()
            +getTicketForOwner()
            +downloadTicket()
            +markTicketVerified()
        }
        class AttendanceService {
            <<service>>
            +checkIn()
            +checkOut()
            +findTicketByCode()
            +findTicketByAttendee()
            +markAutoAttendance()
        }
        class ChatService {
            <<service>>
            +ensureGeneralChannel()
            +ensurePrivateChannel()
            +sendMessage()
        }
        class EvaluationService {
            <<service>>
            +createEvaluation()
            +submitEvaluation()
            +getSubmissions()
            +getStats()
        }
        class NotificationService {
            <<service>>
            +sendNotification()
            +listForUser()
            +markAsRead()
        }
        class EmailService {
            <<service>>
            +sendEmail()
            +getEmailProvider()
            +getEmailModeLabel()
        }
        class UserService {
            <<service>>
            +listUsers()
            +suspendUser()
            +activateUser()
            +updateProfile()
        }
        class MeetingService {
            <<service>>
            +generateMeetingLink()
            +isMeetingLinkVisible()
        }
        class ReportService {
            <<service>>
            +getDashboardStats()
            +exportEventReport()
        }
        class SettingsService {
            <<service>>
            +getSettings()
            +updateSettings()
            +listEmailTemplates()
        }
        class SupportServices {
            <<service>>
            +syncRegistrantToAudience()
            +createCampaign()
            +createFundingSource()
            +checkBanForRegistration()
        }
    }

    %% --- Core FK / UNIQUE relationships (42, matching the authoritative ERD) ---
    CoreEntities.User "1" --> "0..1" CoreEntities.Profile : user_id UNIQUE
    CoreEntities.User "1" --> "0..*" CoreEntities.User : deleted_by
    CoreEntities.Role "1" --> "0..*" CoreEntities.Profile : role_id
    CoreEntities.Category "1" --> "0..*" CoreEntities.Event : category_id
    CoreEntities.Venue "1" --> "0..*" CoreEntities.Event : venue_id
    CoreEntities.Profile "1" --> "0..*" CoreEntities.Event : organizer_id
    CoreEntities.User "1" --> "0..*" CoreEntities.Event : meeting_link_generated_by
    CoreEntities.Event "1" --> "0..*" CoreEntities.EventImage : event_id
    CoreEntities.Event "1" --> "0..*" CoreEntities.Session : event_id
    CoreEntities.Session "1" --> "0..*" CoreEntities.Speaker : session_id
    CoreEntities.Event "1" --> "0..*" CoreEntities.Registration : event_id
    CoreEntities.Profile "1" --> "0..*" CoreEntities.Registration : attendee_id
    CoreEntities.Registration "1" --> "0..1" CoreEntities.Ticket : registration_id UNIQUE
    CoreEntities.Ticket "1" --> "0..*" CoreEntities.Attendance : ticket_id
    CoreEntities.User "1" --> "0..*" CoreEntities.Ticket : verified_by
    CoreEntities.User "1" --> "0..*" CoreEntities.Attendance : verified_by
    CoreEntities.Event "1" --> "0..*" CoreEntities.Feedback : event_id
    CoreEntities.Profile "1" --> "0..*" CoreEntities.Feedback : attendee_id
    CoreEntities.User "1" --> "0..*" CoreEntities.Notification : user_id
    CoreEntities.Profile "1" --> "0..*" CoreEntities.FileItem : uploaded_by
    CoreEntities.User "1" --> "0..*" CoreEntities.AuditLog : user_id
    CoreEntities.Event "1" --> "0..*" CoreEntities.InvitationLink : event_id
    CoreEntities.Event "1" --> "0..*" CoreEntities.EventOrganizer : event_id
    CoreEntities.User "1" --> "0..*" CoreEntities.EventOrganizer : user_id
    CoreEntities.User "1" --> "0..*" CoreEntities.EventOrganizer : created_by
    CoreEntities.Event "1" --> "0..*" CoreEntities.ChatChannel : event_id
    CoreEntities.User "1" --> "0..*" CoreEntities.ChatChannel : organizer_id
    CoreEntities.Profile "1" --> "0..*" CoreEntities.ChatChannel : attendee_id
    CoreEntities.ChatChannel "1" --> "0..*" CoreEntities.ChatMessage : channel_id
    CoreEntities.User "1" --> "0..*" CoreEntities.ChatMessage : sender_id
    CoreEntities.Event "1" --> "0..*" CoreEntities.Evaluation : event_id
    CoreEntities.User "1" --> "0..*" CoreEntities.Evaluation : created_by
    CoreEntities.Evaluation "1" --> "0..*" CoreEntities.EvaluationQuestion : evaluation_id
    CoreEntities.Evaluation "1" --> "0..*" CoreEntities.EvaluationSubmission : evaluation_id
    CoreEntities.Profile "1" --> "0..*" CoreEntities.EvaluationSubmission : attendee_id
    CoreEntities.EvaluationSubmission "1" --> "0..*" CoreEntities.EvaluationAnswer : submission_id
    CoreEntities.EvaluationQuestion "1" --> "0..*" CoreEntities.EvaluationAnswer : question_id
    CoreEntities.Event "1" --> "0..*" CoreEntities.EventCost : event_id
    CoreEntities.User "1" --> "0..*" CoreEntities.EventCost : created_by
    CoreEntities.User "1" --> "0..*" CoreEntities.EventCost : updated_by
    CoreEntities.User "1" --> "0..*" CoreEntities.DeviceSession : user_id
    CoreEntities.User "1" --> "0..*" CoreEntities.PasswordResetToken : user_id

    %% --- Support / app-level relationships ---
    CoreEntities.Event "1" --> "0..*" SupportEntities.MeetingPresence : event_id
    CoreEntities.Profile "1" --> "0..*" SupportEntities.MeetingPresence : attendee_id
    CoreEntities.Event "1" --> "0..*" SupportEntities.MeetingChatMessage : event_id
    CoreEntities.User "0..1" --> "0..*" SupportEntities.AudienceContact : userId nullable
    CoreEntities.User "1" --> "0..*" SupportEntities.AudienceAccessGrant : user_id
    SupportEntities.EmailCampaign "1" --> "0..*" SupportEntities.EmailCampaignRecipient : campaign_id
    CoreEntities.Event "0..1" --> "0..*" SupportEntities.EmailCampaign : target_event_id
    SupportEntities.FundingSource "1" --> "0..*" SupportEntities.Expense : funding_id
    SupportEntities.Currency "1" --> "0..*" SupportEntities.FundingSource : currency_code
    SupportEntities.Currency "1" --> "0..*" SupportEntities.Expense : currency_code
    CoreEntities.Event "0..1" --> "0..*" SupportEntities.Expense : event_id
    SupportEntities.FundTransfer "0..*" --> "1" SupportEntities.FundingSource : funding_id
    SupportEntities.UserBan "1" --> "0..*" SupportEntities.BanRevokeRequest : ban_id
    CoreEntities.Event "0..1" --> "0..*" SupportEntities.UserBan : event_id
    SupportEntities.EventRequest "0..1" --> "0..1" CoreEntities.Event : created_event_id
    SupportEntities.AdminMessage "1" --> "0..*" SupportEntities.AdminMessageRecipient : message_id
    CoreEntities.Event "0..1" --> "0..*" SupportEntities.AdminMessage : event_id
    CoreEntities.User "1" --> "0..*" SupportEntities.PasswordOtpCode : user_id
    CoreEntities.User "0..1" --> "0..*" SupportEntities.PasswordResetRequestItem : user_id
    CoreEntities.User "0..1" --> "0..*" SupportEntities.PasswordResetRequestItem : handled_by
    CoreEntities.ChatMessage <|-- AppViews.ChatMessageWithSender : extends
    AppViews.AudienceAccess ..> SupportEntities.AudienceAccessGrant : grant
    AppViews.FinanceSummary ..> SupportEntities.Currency : byCurrency

