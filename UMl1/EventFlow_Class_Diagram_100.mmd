---
title: EventFlow — مخطط الفئات (Class Diagram)
config:
  theme: default
  look: classic
  layout: dagre
  deterministicIds: true
  deterministicIDSeed: eventflow-class
  handDrawnSeed: 1
---
%% مصدر الحقيقة: src/types/index.ts + src/services/* + supabase/schema.sql +
%% supabase/migrations/2026-11-06_all_additions.sql + ERD الأساسي (30 جدولاً).
%% CoreEntities = 30 فئة تقابل الجداول الأساسية في ERD؛ كل علاقة FK/UNIQUE فعلية.
%% SupportEntities = كيانات مساندة/app-level موجودة في النوع أو الهجرات، لا تُضاف لـ ERD.
%% ServiceModules = وحدات خدمات فعلية (دوال مُصدّرة)، لا فئات OO بالمعنى الصارم.
%% AppSettings تضمّن emailTemplates على مستوى التطبيق (بلا FK).
%% User.passwordHash و DeviceSession.token و PasswordResetToken.token مغلقة عن العميل.
classDiagram
    direction LR

    namespace CoreEntities {
        class User {
            <<entity>>
            +id: string
            +email: string
            +passwordHash: string
            +suspended: boolean
            +mustChangePassword: boolean
            +deletedAt: string
            +scheduledDeletionAt: string
            +deletedBy: string
        }
        class Role {
            <<entity>>
            +id: string
            +name: RoleName
            +description: string
        }
        class Profile {
            <<entity>>
            +id: string
            +userId: string
            +roleId: string
            +firstName: string
            +lastName: string
            +managesAllEvents: boolean
        }
        class Category {
            <<entity>>
            +id: string
            +name: string
            +deletedAt: string
        }
        class Venue {
            <<entity>>
            +id: string
            +name: string
            +capacity: number
            +facilities: Record
            +imageUrls: string[]
        }
        class Event {
            <<entity>>
            +id: string
            +title: string
            +organizerId: string
            +venueId: string
            +categoryId: string
            +capacity: number
            +status: EventStatus
            +visibility: EventVisibility
            +eventType: EventType
            +meetingLink: string
            +onlineCapacity: number
            +inPersonCapacity: number
            +meetingProvider: string
            +meetingAttendanceMinutes: number
            +deletedAt: string
        }
        class EventImage {
            <<entity>>
            +id: string
            +eventId: string
            +imageUrl: string
        }
        class Session {
            <<entity>>
            +id: string
            +eventId: string
            +title: string
            +startTime: string
            +endTime: string
            +roomName: string
        }
        class Speaker {
            <<entity>>
            +id: string
            +sessionId: string
            +name: string
            +bio: string
        }
        class Registration {
            <<entity>>
            +id: string
            +eventId: string
            +attendeeId: string
            +registeredAt: string
            +status: RegistrationStatus
            +attendanceMode: AttendanceMode
        }
        class Ticket {
            <<entity>>
            +id: string
            +registrationId: string
            +uniqueCode: string
            +qrPayload: string
            +status: TicketStatus
            +attendanceMode: AttendanceMode
            +verifiedBy: string
            +verifiedAt: string
        }
        class Attendance {
            <<entity>>
            +id: string
            +ticketId: string
            +checkInTime: string
            +checkOutTime: string
            +mode: AttendanceMode
            +source: AttendanceSource
            +verifiedBy: string
            +presenceSeconds: number
        }
        class Feedback {
            <<entity>>
            +id: string
            +eventId: string
            +attendeeId: string
            +rating: number
            +response: string
            +submittedAt: string
        }
        class Notification {
            <<entity>>
            +id: string
            +userId: string
            +type: NotificationType
            +message: string
            +readAt: string
            +link: string
        }
        class FileItem {
            <<entity>>
            +id: string
            +name: string
            +url: string
            +uploadedBy: string
        }
        class AuditLog {
            <<entity>>
            +id: string
            +userId: string
            +action: AuditAction
            +entityType: string
            +entityId: string
            +ipAddress: string
        }
        class InvitationLink {
            <<entity>>
            +id: string
            +eventId: string
            +email: string
            +code: string
            +used: boolean
            +usedAt: string
        }
        class EventOrganizer {
            <<entity>>
            +id: string
            +eventId: string
            +userId: string
            +isPrimary: boolean
            +createdBy: string
        }
        class ChatChannel {
            <<entity>>
            +id: string
            +eventId: string
            +channelType: ChatChannelType
            +organizerId: string
            +attendeeId: string
        }
        class ChatMessage {
            <<entity>>
            +id: string
            +channelId: string
            +senderId: string
            +content: string
        }
        class Evaluation {
            <<entity>>
            +id: string
            +eventId: string
            +title: string
            +ratingType: RatingType
            +privacy: EvaluationPrivacy
            +createdBy: string
        }
        class EvaluationQuestion {
            <<entity>>
            +id: string
            +evaluationId: string
            +question: string
            +questionType: EvaluationQuestionType
            +options: string[]
            +sortOrder: number
        }
        class EvaluationSubmission {
            <<entity>>
            +id: string
            +evaluationId: string
            +attendeeId: string
            +rating: number
            +isPublic: boolean
        }
        class EvaluationAnswer {
            <<entity>>
            +id: string
            +submissionId: string
            +questionId: string
            +answer: string
        }
        class EventCost {
            <<entity>>
            +id: string
            +eventId: string
            +costType: CostType
            +item: string
            +quantity: number
            +unitPrice: number
            +createdBy: string
            +updatedBy: string
        }
        class DeviceSession {
            <<entity>>
            +id: string
            +userId: string
            +deviceName: string
            +token: string
            +isCurrent: boolean
            +lastActiveAt: string
        }
        class PasswordResetToken {
            <<entity>>
            +id: string
            +userId: string
            +token: string
            +expiresAt: string
            +usedAt: string
        }
        class AppSettings {
            <<entity>>
            +appName: string
            +timezone: string
            +dateFormat: string
            +primaryColor: string
            +logoUrl: string
            +faviconUrl: string
        }
        class EmailTemplate {
            <<entity>>
            +id: string
            +type: string
            +subject: string
            +body: string
        }
        class AuthAttempt {
            <<entity>>
            +id: string
            +email: string
            +attemptedAt: string
        }
    }

    namespace SupportEntities {
        class MeetingPresence {
            <<support>>
            +id: string
            +eventId: string
            +attendeeId: string
            +totalSeconds: number
            +attended: boolean
        }
        class MeetingChatMessage {
            <<support>>
            +id: string
            +eventId: string
            +senderId: string
            +content: string
        }
        class AudienceContact {
            <<support>>
            +id: string
            +email: string
            +tags: string[]
            +source: string
            +status: AudienceContactStatus
            +userId: string
        }
        class AudienceAccessGrant {
            <<support>>
            +id: string
            +userId: string
            +canView: boolean
            +canEdit: boolean
            +canSend: boolean
            +expiresAt: string
        }
        class EmailCampaign {
            <<support>>
            +id: string
            +name: string
            +targetType: CampaignTargetType
            +recipientStatus: RecipientStatusFilter
            +status: CampaignStatus
            +createdBy: string
        }
        class EmailCampaignRecipient {
            <<support>>
            +id: string
            +campaignId: string
            +contactId: string
            +email: string
            +status: string
        }
        class FundingSource {
            <<support>>
            +id: string
            +name: string
            +scope: FundingScope
            +eventId: string
            +currencyCode: string
            +amountUsd: number
        }
        class Expense {
            <<support>>
            +id: string
            +eventId: string
            +fundingId: string
            +currencyCode: string
            +amountUsd: number
