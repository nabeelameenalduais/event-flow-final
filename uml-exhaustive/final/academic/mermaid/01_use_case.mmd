%% ==================================================================
%% EventFlow - Use Case Diagram (English) - matched 1:1 with the code
%% Layout: sample-template (portrait), actors + use cases per group.
%% ==================================================================
%% Evidence:
%%   routes/index.tsx            -> every page + role guard
%%   eventService.ts             -> registerForEvent (confirm/waitlist, invite
%%                                  checks), cancelRegistration (waitlist
%%                                  promotion), publish/archive/draft,
%%                                  duplicate/delete, setMeetingLink
%%   attendanceService.ts        -> checkIn / checkOut / findTicketByCode /
%%                                  markAutoAttendance
%%   invitationService.ts        -> createLink(s), getLinkByCode, markLinkAsUsed
%%   evaluationService.ts        -> build evaluations + submitEvaluation
%%   feedbackService.ts          -> submitFeedback / list / respond
%%   chatService.ts + useChat.ts -> community & private 1:1 chat, AI assistant
%%                                  (LM Studio + 6 data tools)

classDef actor  fill:#e8eef7,stroke:#455a64,stroke-width:2.2;
classDef uc     fill:#f4f8ff,stroke:#0b3d91,stroke-width:1.6;
classDef syst   fill:#fdf3e3,stroke:#b7791f,stroke-width:1.4,stroke-dasharray:6 4;
classDef extern fill:#fdecea,stroke:#b91c1c,stroke-width:1.8;
classDef note   fill:#fff9e6,stroke:#d9a441,stroke-width:1.2;

subgraph System["EventFlow System - system boundary"]
    subgraph VisitorCases["Visitor (unauthenticated)"]
        Visitor(["Visitor"])
        UC01["Browse & search<br/>published events"]
        UC02["View event detail,<br/>schedule & reviews"]
        UC03["Register a<br/>new account"]
        UC04["Log in with<br/>email + password"]
        UC05["Forgot /<br/>reset password"]
    end

    subgraph AttendeeCases["Attendee (role: attendee)"]
        Attendee(["Attendee"])
        UC06["Register for public event<br/>(auto ticket / waitlist)"]
        UC07["Register for private event<br/>with invitation code"]
        UC08["View / download<br/>QR ticket"]
        UC09["Cancel own registration<br/>(may auto-promote waitlist)"]
        UC10["Submit feedback<br/>(rating + comment)"]
        UC11["Submit event<br/>evaluation (questions)"]
        UC12["Chat: community<br/>or private 1:1"]
        UC13["Ask the AI assistant<br/>(global widget, LM Studio)"]
        UC14["View notifications<br/>& reminders"]
        UC15["Join online meeting<br/>(auto check-in)"]
    end

    subgraph OrganizerCases["Organizer (event manager)"]
        Organizer(["Organizer"])
        UC16["Create / edit / duplicate /<br/>delete event"]
        UC17["Manage lifecycle:<br/>draft / publish / archive"]
        UC18["Manage schedule:<br/>sessions & speakers"]
        UC19["Manage registrations<br/>& waitlist"]
        UC20["QR check-in /<br/>check-out attendees"]
        UC21["Generate & share<br/>invitation links"]
        UC22["Manage event costs<br/>(planned / actual)"]
        UC23["Build evaluations &<br/>invite attendees"]
        UC24["Review & respond<br/>to feedback"]
        UC25["Set online<br/>meeting link"]
    end

    subgraph AdminCases["Administrator (platform)"]
        Admin(["Administrator"])
        UC26["Manage users,<br/>roles & suspension"]
        UC27["Manage<br/>categories"]
        UC28["Manage<br/>venues"]
        UC29["Manage<br/>global files"]
        UC30["Assign & manage<br/>event organizers"]
        UC31["View reports<br/>& analytics"]
        UC32["Configure settings<br/>& email templates"]
        UC33["Security center: sessions<br/>+ audit log"]
        UC34["Manage all events<br/>(flag: manage-all)"]
    end
end

LM(["LM Studio - external AI model<br/>connects to UC13:<br/>6 tools (search / details /<br/>categories / venues / stats)"])

