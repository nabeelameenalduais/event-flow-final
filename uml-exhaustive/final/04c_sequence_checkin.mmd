---
title: EventFlow — تسلسل الدخول/التحقق (Check-in) حضوريًا وأونلاين
---
%% Source: src/services/attendanceService.ts (checkIn, checkOut, findTicketByCode,
%%        markAutoAttendance), src/services/ticketService.ts (getTicketByCode),
%%        src/pages (CheckIn page + QrScanner).

sequenceDiagram
    autonumber
    participant O as المنظم (جهاز الفحص)
    participant CAM as كاميرا QR
    participant UI as صفحة Check-in
    participant AT as attendanceService
    participant DB as Supabase (RLS)
    participant AU as auditService

    rect rgb(240, 248, 255)
    Note over O,AU: 1) الفحص بالكاميرا (Happy Path)
    O->>CAM: فتح الكاميرا / html5-qrcode
    CAM-->>O: قراءة unique_code من QR
    O->>UI: رمز التذكرة
    UI->>AT: checkIn(ticketId)  أو findTicketByCode(code)
    AT->>DB: SELECT tickets + registration(status)
    DB-->>AT: ticket (status='valid', registration='confirmed')
    AT->>DB: UPDATE tickets SET status='used'
    AT->>DB: INSERT attendance (check_in_time=now)
    AT->>AU: logAction(..., "checkin", ...)
    DB-->>AT: attendance
    AT-->>UI: { status: "success", checkInTime }
    UI-->>O: "تم الدخول بنجاح" (أخضر)
    end

    rect rgb(255, 248, 245)
    Note over O,AU: 2) سيناريوهات الفشل أثناء الفحص
    alt تذكرة غير موجودة
        AT-->>UI: "Ticket not found"
    else تذكرة مستخدمة سابقًا
        AT-->>UI: "Ticket already checked in" (منع إعادة الدخول)
    else تسجيل غير مؤكد (pending/waitlisted/cancelled)
        AT-->>UI: "Registration is not confirmed — cannot check in"
    else فعالية private ورمز خاطئ في findTicketByCode
        AT-->>UI: undefined => "No ticket found"
    end
    UI-->>O: رسالة خطأ حمراء + إمكانية إعادة الفحص
    end

    rect rgb(245, 250, 245)
    Note over O,AU: 3) دخول يدوي (Manual fallback)
    O->>UI: إدخال الكود يدويًا
    UI->>AT: findTicketByCode(code)
    AT->>DB: SELECT tickets WHERE unique_code ILIKE code (join registration.status)
    alt التسجيل غير مؤكد
        AT-->>UI: undefined
        UI-->>O: "رمز غير صالح أو تسجيل غير مؤكد"
    else موجود ومؤكد
        AT-->>UI: ticket
        UI-->>O: تأكيد الدخول => checkIn(ticket.id)
    end
    end

    rect rgb(250, 245, 250)
    Note over O,AU: 4) تسجيل الخروج (Check-out)
    O->>UI: "تسجيل خروج"
    UI->>AT: checkOut(attendanceId)
    AT->>DB: UPDATE attendance SET check_out_time=now
    DB-->>AT: attendance
    AT-->>UI: "تم تسجيل الخروج"
    end

    rect rgb(250, 250, 245)
    Note over O,AU: 5) حضور تلقائي للفعاليات أونلاين (فتح رابط الاجتماع)
    O->>UI: فتح meeting_link
    UI->>AT: markAutoAttendance(eventId, attendeeId)
    AT->>DB: SELECT tickets (join registration confirmed)
    alt لا تذكرة (غير مسجل/غير مؤكد)
        AT-->>UI: return (لا شيء)
    else توجد تذكرة ولم يحضر سابقًا
        AT->>DB: UPDATE tickets SET status='used'
        AT->>DB: INSERT attendance (idempotent)
        AT-->>UI: done
    else حضر مسبقًا
        AT->>DB: SELECT attendance EXISTS
        AT-->>UI: return (لا ازدواج)
    end
    end
