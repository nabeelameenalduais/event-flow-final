%% ==================================================================
%% EventFlow - Authentication sequence: login, registration, session
%% restore, logout, password reset (matched to src/services/authService.ts,
%% src/contexts/AuthContext.tsx, src/services/rateLimit.ts,
%% src/services/deviceSessionService.ts, supabase/schema.sql RPCs)
%% ==================================================================

    actor U as User
    participant PG as Login / Register page
    participant CX as AuthContext
    participant SV as authService
    participant RL as rateLimit (in-memory)
    participant DB as Supabase RPCs<br/>(SECURITY DEFINER)
    participant DS as deviceSessionService
    participant AU as auditService
    participant LS as localStorage

    Note over U,LS: --- LOG IN (authService.login, rate-limit key: login:EMAIL) ---
    U->>PG: submit email + password
    PG->>CX: login(email, password)
    CX->>SV: authService.login(email, password)
    SV->>RL: withRateLimit("login:EMAIL", fn)
    alt over 30 requests / 60 s
        RL-->>SV: throw "Rate limit exceeded. Try again in..."
        SV-->>CX: error
        CX-->>U: "Invalid email or password"
    else ok
        RL-->>SV: proceed
        SV->>DB: rpc("authenticate_user", p_email, p_password)
        DB->>DB: count auth_attempts for email (last 15 min)
        alt count is 5 or more
            DB-->>SV: error "Too many attempts. Please try again later."
        else
            DB->>DB: load user by email
            alt user missing
                DB->>DB: insert auth_attempts row
                DB-->>SV: error "Invalid email or password"
            else
                DB->>DB: verify password (bcrypt crypt() or legacy sha256)
                alt hash mismatch
                    DB->>DB: insert auth_attempts row
                    DB-->>SV: error "Invalid email or password"
                else
                    DB->>DB: check suspended flag
                    alt suspended
                        DB-->>SV: error "Account is suspended"
                    else
                        DB->>DB: clear auth_attempts then load profile + role
                        DB-->>SV: { user, profile, role } (no password hash)
                    end
                end
            end
        end
        SV->>AU: logAction(user, "login", "user", ...) (fire-and-forget)
        SV-->>CX: AuthResult { user, profile, role }
        CX->>DS: createDeviceSession(user.id)
        DS->>DS: token = crypto.randomUUID() then device name from user-agent
        DS->>DB: insert device_sessions (user_id, token, device_name, ip)
        DB-->>DS: ok
        DS-->>CX: session.token
        CX->>LS: setItem("eventflow_session", token)
        CX-->>U: isAuthenticated = true -> /dashboard
    end

    Note over U,LS: --- REGISTER (authService.register, rate-limit key: register:EMAIL) ---
    U->>PG: submit name + email + password
    PG->>CX: register(email, password, firstName, lastName)
    CX->>SV: authService.register(...)
    SV->>RL: withRateLimit("register:EMAIL", fn)
    RL-->>SV: ok
    SV->>DB: rpc("register_user", ...)
    DB->>DB: reject if email exists ("Email already in use")
    DB->>DB: bcrypt hash (gen_salt bf 10) then insert users + attendee profile
    DB-->>SV: { user, profile, role: attendee }
    SV->>AU: logAction(user, "register", "user", ...) (fire-and-forget)
    SV-->>CX: AuthResult
    CX->>DS: createDeviceSession(user.id)
    CX->>LS: setItem("eventflow_session", token)
    CX-->>U: authenticated as attendee

    Note over U,LS: --- SESSION RESTORE on app boot (AuthContext useEffect) ---
    CX->>LS: read token from "eventflow_session"
    alt no token
        CX->>CX: isLoading = false (guest)
    else token present
        CX->>SV: authService.restoreSession(token)
        SV->>DB: rpc("get_session_user", p_token)
        DB->>DB: find device_sessions by token then update last_active_at
        DB->>DB: check suspended then load profile + role (device_session_id)
        DB-->>SV: { user, profile, role, device_session_id }
        SV-->>CX: AuthResult
        CX->>CX: isAuthenticated = true
        alt missing / suspended session
            SV-->>CX: error "Session expired"
            CX->>LS: removeItem("eventflow_session")
        end
    end

    Note over U,LS: --- LOGOUT (AuthContext.logout) ---
    U->>CX: logout()
    CX-->SV: revokeSession(token) (fire-and-forget)
    SV->>DB: rpc("revoke_session", p_token) -> delete device_sessions
    CX->>LS: removeItem("eventflow_session")
    CX-->>U: isAuthenticated = false

    Note over U,LS: --- PASSWORD RESET (dev mode returns the token) ---
    U->>PG: submit email on /forgot-password
    PG->>SV: requestPasswordReset(email)
    SV->>DB: rpc("request_password_reset", p_email)
    DB->>DB: invalidate old unused tokens then create token (24 random bytes)<br/>+ expires_at = now + 30 min
    DB-->>SV: { ok, token, expires_at } (uniform response, anti-enumeration)
    SV-->>PG: result
    PG-->>U: show /reset-password?token=... (valid 30 min, single use)
    U->>PG: submit new password on /reset-password
    PG->>SV: resetPasswordWithToken(token, newPassword)
    SV->>DB: rpc("reset_password_with_token", ...)
    DB->>DB: validate: unused, not expired, length 6 or more
    DB->>DB: bcrypt hash new password then mark token used
    DB->>DB: delete ALL device_sessions for the user (force re-login)
    DB-->>SV: { ok: true }
    SV-->>PG: success

    Note over U,LS: LEGACY FALLBACK - if an RPC is missing (PGRST202), the client falls<br/>back to the original flow: sha256(password) check against users.password_hash<br/>and a JSON session snapshot in "eventflow_session_legacy".