%% --- Relationships (FK / UNIQUE constraint evidence from supabase/schema.sql) ---

User "1" --> "1" Profile : profiles.user_id UNIQUE
Role "1" --> "N" Profile : profiles.role_id FK
Category "1" --> "N" Event : events.category_id FK
Venue "1" --> "N" Event : events.venue_id FK (nullable)
Profile "1" --> "N" Event : events.organizer_id FK -> profiles.id
User "1" --> "N" Event : events.meeting_link_generated_by FK (nullable)
Event "N" --> "M" User : "event_organizers UNIQUE (event_id, user_id)"
Event "1" --> "N" EventOrganizer : FK
User "1" --> "N" EventOrganizer : FK
Event "1" --> "N" Session : sessions.event_id FK
Session "1" --> "N" Speaker : speakers.session_id FK
Event "1" --> "N" Registration : registrations.event_id FK
Profile "1" --> "N" Registration : registrations.attendee_id FK -> profiles.id
Registration "1" --> "1" Ticket : tickets.registration_id UNIQUE
Ticket "1" --> "N" Attendance : attendance.ticket_id FK (app expects <=1)
Event "1" --> "N" InvitationLink : invitation_links.event_id FK
Event "1" --> "N" ChatChannel : chat_channels.event_id FK
User "1" --> "N" ChatChannel : chat_channels.organizer_id FK (nullable)
Profile "1" --> "N" ChatChannel : chat_channels.attendee_id FK (nullable)
ChatChannel "1" --> "N" ChatMessage : chat_messages.channel_id FK
User "1" --> "N" ChatMessage : chat_messages.sender_id FK -> users.id
ChatMessage <|-- ChatMessageWithSender : extends (application-level, no table)
Event "1" --> "N" Feedback : feedback.event_id FK
Profile "1" --> "N" Feedback : feedback.attendee_id FK -> profiles.id
Event "1" --> "N" Evaluation : evaluations.event_id FK (app enforces 1)
User "1" --> "N" Evaluation : evaluations.created_by FK
Evaluation "1" --> "N" EvaluationQuestion : evaluation_questions.evaluation_id FK
Evaluation "1" --> "N" EvaluationSubmission : evaluation_submissions.evaluation_id FK
Profile "1" --> "N" EvaluationSubmission : evaluation_submissions.attendee_id FK
EvaluationSubmission "1" --> "N" EvaluationAnswer : evaluation_answers.submission_id FK
EvaluationQuestion "1" --> "N" EvaluationAnswer : evaluation_answers.question_id FK
Event "1" --> "N" EventCost : event_costs.event_id FK
User "1" --> "N" EventCost : event_costs.created_by FK
User "1" --> "N" Notification : notifications.user_id FK
Profile "1" --> "N" FileItem : files.uploaded_by FK -> profiles.id
User "1" --> "N" AuditLog : audit_logs.user_id FK
User "1" --> "N" DeviceSession : device_sessions.user_id FK

