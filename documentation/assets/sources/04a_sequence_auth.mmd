---
title: EventFlow — تسلسل المصادقة (Login / Register / Restore / Logout / Password Reset)
---
%% Source: src/contexts/AuthContext.tsx, src/services/authService.ts,
%%        src/services/deviceSessionService.ts, src/lib/rateLimit.ts,
%%        supabase/schema.sql (RPCs), schema-part2-security.sql.
%% مسار RPC عبر SECURITY DEFINER؛ عند غياب الدالة (PGRST202) يتحول إلى مسار
%% Legacy (SHA-256) حفاظًا على التوافق، وكلمة المرور لا تغادر الخادم أبدًا
%% في المسار الجديد (bcrypt داخل PL/pgSQL).

sequenceDiagram
    autonumber
    participant U as المستخدم (المتصفح)
    participant A as AuthContext
    participant S as authService
    participant R as RateLimiter
    participant L as Legacy (SHA-256)
    participant DB as Supabase (RPC/RLS)
    participant AU as auditService

    rect rgb(240, 248, 255)
    Note over U,AU: 1) تسجيل الدخول (Login)
    U->>A: login(email, password)
    A->>A: setState(isLoading=true)
    A->>S: authService.login(email, password)
    S->>R: withRateLimit("login:{email}")
    alt تجاوز الحد (5 محاولات / 15 دقيقة)
        R-->>S: RATE_LIMITED
        S-->>A: رمي خطأ
        A-->>U: رسالة "حاول لاحقًا"
    else ضمن الحد
        S->>DB: rpc("authenticate_user", {p_email, p_password})
        alt الدالة غير موجودة (PGRST202)
            DB-->>S: error: PGRST202
            S->>L: legacyLogin(email, password)
            L->>DB: SELECT users + profiles + roles (anon)
            DB-->>L: صف المستخدم (password_hash)
            L->>L: sha256(password) مطابقة
            alt صحيح
                L->>DB: insert/audit
                L-->>S: AuthResult (user+profile+role)
            else كلمة مرور خاطئة
                L-->>S: رمي "Invalid email or password"
            end
        else الدالة موجودة
            alt تحقق عدد المحاولات >= 5
                DB-->>S: {"error": "Too many attempts..."}
            else مستخدم غير موجود
                DB->>DB: insert auth_attempts
                DB-->>S: {"error": "Invalid email or password"}
            else كلمة مرور خاطئة
                DB->>DB: insert auth_attempts
                DB-->>S: {"error": "Invalid email or password"}
            else حساب معلّق
                DB-->>S: {"error": "Account is suspended"}
            else نجاح
                DB->>DB: delete auth_attempts للبريد
                DB-->>S: JSON(user, profile, role) — بلا password_hash
                S->>AU: logAction(id, "login", ...) (fire-and-forget)
                S-->>A: AuthResult
            end
        end
    end
    A->>S: sessionService.createDeviceSession(user.id)
    S->>S: generateSessionToken() = crypto.randomUUID()
    S->>DB: INSERT device_sessions(token) (insert فقط — قراءة محظورة)
    DB-->>S: {token: ...} محلي
    A->>A: localStorage.setItem("eventflow_session", token)
    A->>A: setState(isAuthenticated=true, role=...)
    A-->>U: توجيه حسب الدور (Organizer/Admin => /dashboard)
    end

    rect rgb(250, 250, 245)
    Note over U,AU: 2) تسجيل حساب جديد (Register) — دور attendee دائمًا
    U->>A: register(email, password, firstName, lastName)
    A->>S: authService.register(...)
    S->>R: withRateLimit("register:{email}")
    S->>DB: rpc("register_user", {...})
    alt الدالة غير موجودة (PGRST202)
        DB-->>S: error PGRST202
        S->>L: legacyRegister(...)
        L->>DB: roles (attendee) -> INSERT users (sha256) -> INSERT profiles
        alt البريد مستخدم مسبقًا
            L-->>S: رمي "Registration failed"
        else نجاح
            L-->>S: AuthResult (role=attendee)
        end
    else
        alt البريد مستخدم مسبقًا
            DB-->>S: {"error": "Email already in use"}
            S-->>A: رمي خطأ
        else نجاح
            DB->>DB: INSERT users (bcrypt) + INSERT profiles (attendee)
            DB-->>S: JSON(user, profile, role=attendee)
            S->>AU: logAction(id, "register", ...)
            S-->>A: AuthResult
        end
    end
    A->>S: createDeviceSession(user.id)
    A->>A: localStorage.setItem(...) + setState
    A-->>U: دخول تلقائي
    end

    rect rgb(245, 250, 245)
    Note over U,AU: 3) استعادة الجلسة عند إعادة التحميل (Restore)
    A->>A: useEffect: token = localStorage.getItem(...)
    alt يوجد token
        A->>S: restoreSession(token)
        S->>DB: rpc("get_session_user", {p_token})
        DB->>DB: update last_active_at
        alt token غير موجود / انتهى / معلّق
            DB-->>S: {"error": "Session not found"|"Account is suspended"}
            S-->>A: رمي خطأ
            A->>A: localStorage.removeItem(...) + isLoading=false
        else نجاح
            DB-->>S: JSON(user, profile, role, device_session_id)
            A->>A: setState(isAuthenticated=true)
        end
    else لا يوجد token
        A->>A: isLoading=false (ضيف)
    end
    end

    rect rgb(255, 248, 245)
    Note over U,AU: 4) استعادة كلمة المرور (F1.3) — استجابة موحدة ضد Enumeration
    U->>A: requestPasswordReset(email)
    A->>S: authService.requestPasswordReset(email)
    S->>DB: rpc("request_password_reset", {p_email})
    alt بريد غير موجود (استجابة موحدة)
        DB-->>S: {"error": "If that email exists, a reset link has been sent."}
        S-->>U: نفس الرسالة (لا تمييز)
    else بريد موجود
        DB->>DB: حذف التوكنات غير المستخدمة السابقة
        DB->>DB: توليد token = gen_random_bytes(24) + انتهاء 30 دقيقة
        DB-->>S: {"ok": true, "token", "expires_at"}
        Note over S,U: في هذا العرض يظهر التوكن للمستخدم "كأنه بريد"
    end
    U->>A: resetPassword(token, newPassword)
    A->>S: resetPasswordWithToken(token, newPassword)
    S->>DB: rpc("reset_password_with_token", {p_token, p_new_password})
    alt توكن تالف أو منتهي
        DB-->>S: {"error": "Reset token is invalid or expired."}
    else كلمة مرور < 6 أحرف
        DB-->>S: {"error": "Password must be at least 6 characters."}
    else نجاح
        DB->>DB: UPDATE users (bcrypt) + ترميز used_at
        DB->>DB: DELETE device_sessions (إبطال كل الجلسات)
        DB-->>S: {"ok": true}
        S-->>U: نجاح (يجب إعادة تسجيل الدخول)
    end
    end

    rect rgb(245, 245, 250)
    Note over U,AU: 5) تسجيل الخروج وإبطال الجلسة
    U->>A: logout()
    A->>A: token = localStorage.getItem(...)
    alt يوجد token
        A->>S: revokeSession(token)
        S->>DB: rpc("revoke_session", {p_token})
        alt الدالة غير موجودة
            S->>L: clearLegacySession()
        else نجاح
            DB->>DB: DELETE device_sessions WHERE token=...
            S->>AU: logAction("", "logout", ...)
        end
    end
    A->>A: localStorage.removeItem(...) + setState(null)
    A-->>U: عودة لصفحة الدخول
    end
